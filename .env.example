# Copiar a .env y ajustar.

# PostgreSQL de desarrollo (docker-compose.yml, servicio "db")
DATABASE_URL="postgresql://feacomech:feacomech_dev@localhost:5434/feacomech?schema=public"

# PostgreSQL de pruebas (servicio "db-test"); lo usan las pruebas de integración
DATABASE_URL_TEST="postgresql://feacomech:feacomech_test@localhost:5435/feacomech_test?schema=public"

# Clave para sellar la cookie de sesión (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD="cambia-esto-por-una-clave-aleatoria-de-32-caracteres-o-mas"

# Superadministrador inicial que crea el seed (se pide cambiar la contraseña al entrar).
SEED_ADMIN_EMAIL="admin@feacomech.local"
SEED_ADMIN_PASSWORD="Feacomech2026!"

# Correo saliente (SMTP). En desarrollo, Mailpit de docker compose (bandeja: http://localhost:8025).
# Sin NUXT_SMTP_HOST los correos no salen: la plataforma muestra el enlace al administrador.
NUXT_SMTP_HOST="localhost"
NUXT_SMTP_PORT="1025"
# NUXT_SMTP_USER=""
# NUXT_SMTP_PASS=""
# NUXT_SMTP_SECURE="false"          # true para el puerto 465
# NUXT_SMTP_FROM="FEACOMECH <no-responder@dominio>"

# URL pública de la plataforma, para los enlaces de los correos (nunca se toma de la petición).
NUXT_URL_PUBLICA="http://localhost:3001"

# Carpeta de archivos subidos (por defecto ./almacen). En producción: volumen con respaldo.
# NUXT_DIR_ALMACEN=""

# Dónde se guarda el contenido de los archivos: "disco" (carpeta de arriba) o "db" (tabla
# ContenidoArchivo de PostgreSQL). Si no se define: "disco", salvo en Vercel, donde es "db".
# NUXT_ALMACEN=""
